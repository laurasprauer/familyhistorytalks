# ------------------------------------------------------------------
# Family History Talks — environment variables
# Copy to .env for local work. On Netlify: Site configuration →
# Environment variables. See README.md.
# Values starting with "your-" are placeholders and will stop the build.
# ------------------------------------------------------------------

# sanity.io/manage → your project → Project ID
NEXT_PUBLIC_STUDIO_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# sanity.io/manage → API → Tokens → Add token → "Viewer"
# Used by the build scripts to read published content (server-side only)
SANITY_API_READ_TOKEN=your-sanity-viewer-token

# Local: http://localhost:3000 — Netlify: https://familyhistorytalks.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where archive PDFs are served from. Netlify proxies /resources/* to the
# Cloudflare Worker (see generateNetlifyFiles.cjs), so the default is fine.
# NEXT_PUBLIC_RESOURCES_URL=/resources

# Netlify only — sanity.io/manage → API → Tokens → Add token → "Deploy studio"
# Lets the Netlify build redeploy the Studio (familyhistorytalks.sanity.studio)
SANITY_AUTH_TOKEN=your-sanity-deploy-token

# Cloudflare R2 — used by the Studio upload function (netlify/functions/r2-upload-url.js)
# dash.cloudflare.com → R2 → Manage API tokens → Object Read & Write on the bucket
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=familyhistorytalks-resources

# Local only (one-off tasks, not needed on Netlify)
# CLOUDFLARE_API_TOKEN — deploys the Worker in cloudflare/worker (or use `npx wrangler login`)
# SANITY_API_WRITE_TOKEN — "Editor" token for scripts/migrate-from-contentful
