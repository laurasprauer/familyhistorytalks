{
  "name": "familyhistorytalks",
  "version": "0.2.0",
  "private": true,
  "description": "Family Genealogy Website",
  "homepage": "https://familyhistorytalks.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurasprauer/familyhistorytalks"
  },
  "license": "MIT",
  "author": "Laura Sprauer",
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "postinstall": "cd studio && npm install",
    "dev": "npm run generate:slugs && npm run generate:pageData && npm run generate:searchIndex && next dev",
    "generate:slugs": "node ./src/app/utils/generateSlugs.cjs",
    "generate:pageData": "node ./src/app/utils/generatePageData.cjs",
    "generate:searchIndex": "node ./src/app/utils/generateSearchIndex.cjs",
    "generate:sitemap": "node ./src/app/utils/generateSitemap.cjs",
    "generate:netlifyFiles": "node ./src/app/utils/generateNetlifyFiles.cjs",
    "build": "npm run generate:slugs && npm run generate:pageData && npm run generate:searchIndex && npm run generate:sitemap && npm run generate:netlifyFiles && next build",
    "studio": "cd studio && npm run dev",
    "lint": "eslint src/ netlify/",
    "check-node": "node scripts/check-node-version.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@portabletext/react": "^3.2.1",
    "@sanity/client": "^7.15.0",
    "classnames": "^2.5.1",
    "dotenv": "^16.4.7",
    "minisearch": "^7.1.1",
    "next": "^16.1.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sass": "^1.85.1"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.1.6"
  },
  "engines": {
    "node": ">=22.13.1",
    "npm": ">=10.0.0"
  }
}
